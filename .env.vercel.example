# Copy these values into Vercel Project Settings > Environment Variables.
# Do not commit real production secrets.

# Runtime connection. For Neon, prefer the pooled URL with "-pooler" in the host.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Migration connection. For Neon, use the direct URL without "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

AUTH_SECRET="generate-a-long-random-secret"
ADMIN_USERNAMES="mailron"
ADMIN_EMAILS=""

CRON_SECRET="generate-a-long-random-cron-secret"

# Optional: standard OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional: Azure OpenAI
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT=""
AZURE_OPENAI_API_VERSION="2024-10-21"
